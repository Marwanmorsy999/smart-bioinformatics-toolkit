{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-bioinformatics-toolkit.local/schemas/plan.schema.json",
  "title": "AI Platform plan (v1)",
  "description": "Machine contract for the typed plan produced by the control-plane planner. tool_id must exist in the tool registry; external_egress true implies consent_required true.",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "request_id", "domain", "intent", "confidence", "created_at", "steps", "external_services", "consents_required", "limitations"],
  "properties": {
    "plan_id": { "type": "string", "pattern": "^plan_[0-9a-f]{16}$" },
    "request_id": { "type": "string", "pattern": "^req_[0-9a-f]{16}$" },
    "domain": { "type": "string", "enum": ["sequence-analysis", "microbiome-16s"] },
    "intent": { "type": "string", "enum": ["validate_and_profile", "identify_taxa"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tool_id", "backend", "params", "inputs", "external_egress", "consent_required", "estimated_seconds"],
        "properties": {
          "id": { "type": "string", "pattern": "^step_[0-9]+$" },
          "tool_id": { "type": "string", "minLength": 1 },
          "backend": { "type": "string", "enum": ["local-python"] },
          "params": { "type": "object" },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "external_egress": { "type": "boolean" },
          "consent_required": { "type": "boolean" },
          "estimated_seconds": { "type": "integer", "minimum": 0 }
        },
        "allOf": [
          {
            "if": { "properties": { "external_egress": { "const": true } }, "required": ["external_egress"] },
            "then": { "properties": { "consent_required": { "const": true } }, "required": ["consent_required"] }
          }
        ]
      }
    },
    "external_services": { "type": "array", "items": { "type": "string" } },
    "consents_required": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "requires": { "type": "array", "items": { "type": "string" } }
  }
}
