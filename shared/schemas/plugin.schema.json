{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-bioinformatics-toolkit.local/schemas/plugin.schema.json",
  "title": "Tool plugin manifest (v2)",
  "description": "A plugin advertises registered tools to the control plane. It never executes inside a Worker. Every tool must declare scientific references, limitations and machine-checkable contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "description", "backend", "tools"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "backend": { "type": "string", "enum": ["local-python"] },
    "entrypoint": { "type": "string", "minLength": 1 },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "allOf": [
    {
      "anyOf": [
        { "required": ["entrypoint"] },
        { "properties": { "tools": { "items": { "required": ["entrypoint"] } } } }
      ]
    }
  ],
  "$defs": {
    "jsonSchema": {
      "type": "object",
      "minProperties": 1
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "url", "verified"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "verified": { "type": "boolean" },
        "verified_by": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "verified": { "const": false } }, "required": ["verified"] },
          "then": { "required": ["note"] }
        }
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "params_schema",
        "available",
        "references",
        "limitations"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "minLength": 1 },
        "params_schema": { "$ref": "#/$defs/jsonSchema" },
        "input_schema": { "$ref": "#/$defs/jsonSchema" },
        "output_schema": { "$ref": "#/$defs/jsonSchema" },
        "available": { "type": "boolean" },
        "unavailable_reason": { "type": "string", "minLength": 1 },
        "external_egress": { "type": "boolean" },
        "requirements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "requires": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "estimated_seconds": { "type": "integer", "minimum": 0 },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reference" }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "available": { "const": false } }, "required": ["available"] },
          "then": { "required": ["unavailable_reason"] }
        }
      ]
    }
  }
}
